[{\"internalType\":\"bytes\",\"name\":\"message\",\"type\":\"bytes\"},{\"internalType\":\"bytes\",\"name\":\"sig\",\"type\":\"bytes\"},{\"internalType\":\"bytes\",\"name\":\"pk\",\"type\":\"bytes\"}],\"name\":\"verify\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"message\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"sig\",\"type\":\"bytes\"},{\"internalType\":\"bytes\",\"name\":\"pk\",\"type\":\"bytes\"}],\"name\":\"verifyDigest\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Replaces `SPHINCSVerifier.sol`, which was not FIPS 205 and could not be      executed at all \\u2014 673.8M gas on a real signature, twenty-two blocks'      worth (`docs/core/STARK_AIR_GAP_ANALYSIS.md` \\u00a725). This is a rewrite.      Why it matters that this exists: \\u00a727 established that the Groth16 wrap      route, whatever its gas advantage, reduces the protocol's quantum      resistance to BN254's \\u2014 an attacker with a quantum computer forges the      proof and never touches a SPHINCS+ signature. A verifier that is      post-quantum end to end is the only construction that delivers the      protocol's central claim.      Every layer is pinned against `src/crypto/slh-dsa-sha2`, which is in      turn pinned against the independent RustCrypto implementation.\",\"kind\":\"dev\",\"methods\":{\"verify(bytes,bytes,bytes)\":{\"details\":\"The context prefix `0x00 \\u2016 |ctx| \\u2016 ctx` is what a conforming signer      applies by default. A verifier that skipped it would reject every      signature a standard library produces.\",\"params\":{\"message\":\"The signed message\",\"pk\":\"`PK.seed \\u2016 PK.root`\",\"sig\":\"`R \\u2016 SIG_FORS \\u2016 SIG_HT`\"}}},\"title\":\"SLHDSAVerifier - FIPS 205 SLH-DSA-SHA2-128s signature verification\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"signatureSize()\":{\"notice\":\"Signature length this parameter set expects.\"},\"verify(bytes,bytes,bytes)\":{\"notice\":\"`slh_verify(M, SIG, ctx, PK)` (FIPS 205 Algorithm 24), the pure         variant with an empty context.\"},\"verifyDigest(bytes32,bytes,bytes)\":{\"notice\":\"As [`verify`], for a message already reduced to 32 bytes \\u2014 the         shape `L1Vault` signs (`SHA3-256(lockId \\u2016 stateRoot)`).\"}},\"notice\":\"Verifies a post-quantum signature entirely on-chain, with no         elliptic-curve assumption anywhere in the path.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/crypto/SLHDSAVerifier.sol\":\"SLHDSAVerifier\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/=lib/openzeppelin-contracts/\",\":@qs/=src/\",\":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/\",\":lib/openzeppelin-contracts/=lib/openzeppelin-contracts/\",\":openzeppelin-contracts/=lib/openzeppelin-contracts/\"],\"viaIR\":true},\"sources\":{\"src/crypto/SLHDSA.sol\":{\"keccak256\":\"0xc6a31712731f455f73a4753e7928d3003885c17748568f86458e407445a60872\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://94d085b4b41fe7b7cffeb0b3937c7e040f0d92453385b02216ecf3e91c8ce93c\",\"dweb:/ipfs/QmTSJbVRew1kWnLUbWNTxZ4iUZs4ciXEMs1U7wKvrvYq7E\"]},\"src/crypto/SLHDSAVerifier.sol\":{\"keccak256\":\"0xb00a672d8e547a4b6c6607d221ca00bc32cfde0ff9b07dc19e1df1577697397f\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://38a04414f6f18d00fd326e099f2f4526386b85a0e368d0b52b9f9df259e427ef\",\"dweb:/ipfs/QmVaieVxkyaYtv3uATms3iZWzvkJM9QN41GRYQzUmDDZ8Q\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.20+commit.a1b79de6"},"language":"Solidity","output":{"abi":[{"inputs":[],"stateMutability":"pure","type":"function","name":"signatureSize","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"bytes","name":"message","type":"bytes"},{"internalType":"bytes","name":"sig","type":"bytes"},{"internalType":"bytes","name":"pk","type":"bytes"}],"stateMutability":"view","type":"function","name":"verify","outputs":[{"internalType":"bool","name":"","type":"bool"}]},{"inputs":[{"internalType":"bytes32","name":"message","type":"bytes32"},{"internalType":"bytes","name":"sig","type":"bytes"},{"internalType":"bytes","name":"pk","type":"bytes"}],"stateMutability":"view","type":"function","name":"verifyDigest","outputs":[{"internalType":"bool","name":"","type":"bool"}]}],"devdoc":{"kind":"dev","methods":{"verify(bytes,bytes,bytes)":{"details":"The context prefix `0x00 ‖ |ctx| ‖ ctx` is what a conforming signer      applies by default. A verifier that skipped it would reject every      signature a standard library produces.","params":{"message":"The signed message","pk":"`PK.seed ‖ PK.root`","sig":"`R ‖ SIG_FORS ‖ SIG_HT`"}}},"version":1},"userdoc":{"kind":"user","methods":{"signatureSize()":{"notice":"Signature length this parameter set expects."},"verify(bytes,bytes,bytes)":{"notice":"`slh_verify(M, SIG, ctx, PK)` (FIPS 205 Algorithm 24), the pure         variant with an empty context."},"verifyDigest(bytes32,bytes,bytes)":{"notice":"As [`verify`], for a message already reduced to 32 bytes — the         shape `L1Vault` signs (`SHA3-256(lockId ‖ stateRoot)`)."}},"version":1}},"settings":{"remappings":["@openzeppelin/=lib/openzeppelin-contracts/","@qs/=src/","erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/","forge-std/=lib/forge-std/src/","halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/","lib/openzeppelin-contracts/=lib/openzeppelin-contracts/","openzeppelin-contracts/=lib/openzeppelin-contracts/"],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src